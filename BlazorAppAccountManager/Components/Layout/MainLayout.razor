    </main>    
</div>
<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool isAuthenticated = false;
    private string userName = string.Empty;
    private System.Security.Claims.ClaimsPrincipal user = null; // 新增：保存用户信息供UI使用

    private bool isAdmin = false; // 新增：用于跟踪用户是否为超级管理员
    private const string AdminRoleName = "SuperAdmin"; // 定义超级管理员角色名称

    protected override async Task OnInitializedAsync()
    {
        // 订阅身份验证状态变化
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        // 初始加载时获取身份验证状态
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        UpdateUserInfo(authState);

        // **新增：超级管理员重定向逻辑**
        // 只有当用户被识别为管理员后才执行跳转检查
        if (isAdmin && NavigationManager.Uri.EndsWith(NavigationManager.BaseUri))
        {
            // 如果是超级管理员并且当前在根路径 (/)，则跳转到用户管理页
            NavigationManager.NavigateTo("Account/UserManagement", forceLoad: false);
        }
    }

    // 修正：将返回类型改为 void，这是事件处理程序的正确类型
    private void OnAuthenticationStateChanged(Task<AuthenticationState> authStateTask)
    {
        // 因为不能在这里使用 await，所以使用 ContinueWith 处理异步结果
        authStateTask.ContinueWith(task =>
        {
            var authState = task.Result;
            UpdateUserInfo(authState);
        }, TaskScheduler.FromCurrentSynchronizationContext());
    }

    private void UpdateUserInfo(AuthenticationState authState)
    {
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;

        // **关键点：检查用户是否拥有 SuperAdmin 角色**
        isAdmin = user.IsInRole(AdminRoleName);

        if (isAuthenticated)
        {
            // 获取用户名（可根据实际需求调整）
            userName = user.Identity?.Name ?? "用户";
            
            // 保存user变量供UI使用
            this.user = user;
        }
        else
        {
            userName = string.Empty;
            this.user = null;
        }

        StateHasChanged();
    }

    private void HandleLogout()
    {
        // 登出逻辑
        NavigationManager.NavigateTo("/account/logout", forceLoad: true);
    }

    public void Dispose()
    {
        // 取消订阅，避免内存泄漏
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    // 可选：如果需要在代码中处理returnUrl，可以在这里获取
    private string GetReturnUrl()
    {
        return "";
    }

}