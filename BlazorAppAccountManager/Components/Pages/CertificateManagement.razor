    // 编辑供应商 - 确认
    private async Task ConfirmEditSupplier()
    {
        // 验证输入和状态
        if (supplierToEdit == null)
        {
            Logger.LogInformation("未找到要编辑的供应商");
            isEditSupplierDialogVisible = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(editSupplierName))
        {
            Logger.LogInformation("供应商名称不能为空");
            return;
        }

        // 如果名称未变化，直接关闭对话框
        if (supplierToEdit.Name == editSupplierName)
        {
            isEditSupplierDialogVisible = false;
            return;
        }

        try
        {
            // 调用EditSupplierName方法执行更新逻辑
            var result = await SupplierService.EditSupplierName(supplierToEdit.Id, editSupplierName);

            if (!result.IsSuccess)
            {
                // 记录错误信息并返回
                ShowToolTip($"更新失败：{result.ErrorMessage}");
                return;
            }

            Logger.LogInformation("供应商名称更新成功");
            isEditSupplierDialogVisible = false;
        }
        catch (DbUpdateConcurrencyException ex)
        {
            Logger.LogInformation("并发冲突：该供应商信息已被其他操作修改，请刷新后重试");            
        }
        catch (Exception ex)
        {
            Logger.LogInformation($"更新供应商失败：{ex.Message}");
            if (ex.InnerException != null)
                Logger.LogInformation($"内部错误：{ex.InnerException.Message}");
        }
        finally
        {
            await LoadData(); // 重新加载灯具及关联的供应商
            // 强制UI重新渲染以显示更新后的数据
            StateHasChanged();
        }
    }

    // 检查供应商的证书是否被其他项目引用
    private async Task<(bool HasReference, List<string> References)> CheckSupplierCertificateReferences(string supplierId)
    {
