@page "/certificate-management/{lampId}"
@using BlazorAppAccountManager.Components.Configs
@using BlazorAppAccountManager.Components.Data
@using BlazorAppAccountManager.Components.Models
@using BlazorAppAccountManager.Components.Services
@using Blazored.LocalStorage
@using Microsoft.EntityFrameworkCore
@using MatBlazor
@using Microsoft.AspNetCore.WebUtilities
@using Newtonsoft.Json
@using OpenAI
@using OpenAI.Chat
@using System.ClientModel
@using UglyToad.PdfPig
@using iText.Kernel.Pdf
@using Microsoft.Extensions.Options;

@implements IDisposable  // 声明实现IDisposable接口
@rendermode InteractiveServer

@inject IJSRuntime JSRuntime // 用于调用JS实现文件选择
@inject NavigationManager NavManager
@inject CertificateReferenceService ReferenceService
@inject ILocalStorageService LocalStorage
@inject IOptions<TesseractConfig> TesseractOptions
@inject IOptions<DeepSeekSettings> DeepSeekSettingsOptions
@inject ILogger<Home> Logger
@inject SupplierService SupplierService
@inject CertificateService CertificateService
@inject PdfProcessingService PdfProcessingService
 
<style>
    .scroll-container {
        /* 确保它能填满 main-content 的空间 */
        width: 100%;
        height: 100%;
        overflow-x: auto;
        overflow-y: hidden;
    }

    .content-wrapper {
        /* 关键：使用 Flexbox 让子元素水平排列 */
        display: flex;
        /* 防止子元素换行 */
        flex-wrap: nowrap;
        /* 确保内容包裹器的高度是自动的，以适应scroll-container */
        height: 100%;
    }
    /* 确保外部容器没有多余的溢出属性 */
    .container.overflow-hidden {
        /* 你的代码中已经有了这个，它会隐藏溢出，
                   但我们想要在内部的 `scroll-container` 产生滚动条。
                   如果这个类不是必须的，可以考虑移除，
                   或者确保它的效果被内部的 overflow 属性覆盖。*/
    }

    .content-wrapper {
        display: flex;
        gap: 15px; /* Adds space between cards */
        height: 100%;
    }

    .project-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex-shrink: 0;
        width: 280px; /* Fixed width for each card */
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #f9f9f9;
    }

    .info-row {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
    }

    .info-label {
        font-weight: bold;
        flex-shrink: 0;
        margin-right: 8px;
    }

    .info-value {
        flex-grow: 1;
        padding: 5px 10px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background-color: #fff;
        font-size: 0.9em;
    }

    .delete-btn-container {
        display: flex;
        justify-content: flex-end;
        margin-top: 10px;
    }

    .bordered-button {
        border: 1px solid #ccc; /* 边框宽度、样式、颜色 */
        border-radius: 4px; /* 可选：添加圆角使边框更美观 */
        padding: 6px 16px; /* 可选：调整内边距，确保边框与文字距离合适 */
    }

    /* 可选：添加hover效果 */
    .bordered-button:hover {
        border-color: #666; /* 鼠标悬停时边框颜色变化 */
    }

    .bg-light-green {
        min-height: 40px;
        /* 浅绿色背景 */
        background-color: #c3e6cb;
        /* 可选：添加一点内边距和圆角，让样式更美观 */
        padding: 2px 8px;
        border-radius: 4px;
    }

    .bg-light-yellow {
        min-height: 40px;
        /* 浅绿色背景 */
        background-color: #FFF176;
        /* 可选：添加一点内边距和圆角，让样式更美观 */
        padding: 2px 8px;
        border-radius: 4px;
    }

    .current-cert {
        border: 3px solid #ff6b6b; /* 主边框 */
        border-radius: 8px;
        /* 可选：仅保留轻微阴影增强立体感，不创建双层边框效果 */
        /* box-shadow: 0 2px 8px rgba(255, 107, 107, 0.3); */
    }

    /* 为每一行设置 Grid 布局 */
    .item-row {
        display: grid;
        grid-template-columns: 65px auto max-content; /* 第一列固定宽度，第二列自适应，第三列按内容 */
        gap: 3px;
        align-items: center;
    }

    /* 基础样式 - 调整为更温暖的蓝色系 */
    :root {
        --primary-color: #2574a9; /* 主色调：深蓝色 */
        --primary-light: #3a92c5; /* 亮一点的主色 */
        --secondary-color: #8d99ae; /* 次要文本色 */
        --light-bg: #f1f5f9; /* 浅色背景 */
        --border-color: #cbd5e1; /* 边框色 */
        --shadow-sm: 0 2px 6px rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
        --transition: all 0.3s ease;
    }

    /* 控制头部整体区域高度（减少内边距，避免过高） */
    .lamp-header-section {
        padding: 1.5rem 0; /* 上下内边距从默认（通常1rem+）减到0.5rem，降低整体高度 */
        margin-bottom: 0.8rem; /* 与下方内容的间距，按需调整 */
    }

    /* 控制标题字体大小和行高（减小字体，避免过大） */
    .lamp-header-section .lamp-title {
        padding-left: 1.5rem;
        font-size: 1.75rem; /* 原h3默认约1.75rem，调整为1.1rem（可按需微调，如1rem/1.2rem） */
        font-weight: 600; /* 字体粗细：600（半粗）比默认h3的700（粗）更柔和，可选 */
        line-height: 1.3; /* 行高：避免文字垂直占用过多空间 */
        margin: 0; /* 清除h3默认的上下外边距（默认margin-top:1rem/margin-bottom:0.5rem，会增加高度） */
        color: #333; /* 可选：调整字体颜色，更显精致 */
    }

    .lamp-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background-color: var(--primary-color);
        color: white;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 999px;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .lamp-title {
        margin: 0;
        font-size: 1.75rem;
        color: #1e293b;
        line-height: 1.3;
    }

    .divider {
        height: 1px;
        background-color: var(--border-color);
        margin-top: 1rem;
        width: 100%;
    }

    /* 供应商区域 - 第二层视觉焦点 */
    .supplier-section {
        background-color: white;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        overflow: hidden;
        transition: var(--transition);
    }

    .supplier-section:hover {
        box-shadow: var(--shadow-md);
    }

    /* 供应商标题栏 */
    .supplier-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 1.5rem;
        background-color: var(--light-bg);
        border-bottom: 1px solid var(--border-color);
    }

    .supplier-icon {
        color: var(--primary-color);
        font-size: 1.25rem;
        background-color: white;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-sm);
    }

    .supplier-title {
        margin: 0;
        font-size: 1.25rem;
        color: #334155;
        font-weight: 600;
    }

    /* 供应商列表容器 */
    .supplier-list-container {
        padding: 1.5rem;
    }

    /* 供应商卡片 */
    .supplier-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        border-radius: 6px;
        border: 1px solid var(--border-color);
        margin-bottom: 1rem;
        transition: var(--transition);
        background-color: white;
    }

    .supplier-card:hover {
        border-color: var(--primary-color);
        transform: translateY(-2px);
        box-shadow: var(--shadow-sm);
    }

    .supplier-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .supplier-name {
        font-weight: 500;
        color: #1e293b;
        font-size: 1.05rem;
    }

    .supplier-code {
        font-size: 0.875rem;
        color: var(--secondary-color);
    }

    /* 操作按钮 */
    .action-btn {
        padding: 0.375rem 0.75rem;
        border-radius: 4px;
        border: none;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: var(--transition);
        margin-left: 0.5rem;
    }

    .edit-btn {
        background-color: #e6f2f8;
        color: var(--primary-color);
    }

    .edit-btn:hover {
        background-color: #d1e7f1;
    }

    .delete-btn {
        background-color: #fee2e2;
        color: #dc2626;
    }

        .delete-btn:hover {
            background-color: #fecaca;
        }

    /* 空状态样式 */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 1rem;
        color: var(--secondary-color);
        text-align: center;
        gap: 1rem;
        border: 1px dashed var(--border-color);
        border-radius: 6px;
    }

    .empty-state i {
        font-size: 3rem;
        opacity: 0.5;
    }

    .add-first-btn {
        margin-top: 0.5rem;
        padding: 0.5rem 1.25rem;
        background-color: var(--primary-color);
        color: white;
        border: none;
        border-radius: 4px;
        font-weight: 500;
        cursor: pointer;
        transition: var(--transition);
    }

    .add-first-btn:hover {
        background-color: var(--primary-light);
    }

    /* 简单的 CSS 来实现 modal 和 spinner */
    .modal {
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.4); /* 半透明黑色背景 */
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-content {
        background-color: #fefefe;
        padding: 20px;
        border-radius: 5px;
        text-align: center;
        box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2);
    }

    .spinner {
        /* 这里可以放入你的 CSS spinner 代码 */
        border: 4px solid rgba(0, 0, 0, 0.1);
        border-left-color: #3498db;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        animation: spin 1s linear infinite;
        margin: auto;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* 鼠标悬停时可以显示完整内容的提示效果增强 */
    .text-truncate 
    {
        position: relative;
    }

    .text-truncate:hover::after {
        content: attr(title);
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        background-color: #333;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        white-space: nowrap;
        z-index: 100;
        font-size: 12px;
        max-width: 300px; /* 限制提示框最大宽度 */
        overflow-wrap: break-word; /* 长文本换行 */
    }

    .dialog-layout {
        display: flex;
        width: 100%;
        height: 400px; /* 可根据需要调整高度 */
    }

    .result-column {
        flex: 1; /* 左侧占1份宽度 */
        padding: 10px;
        overflow-y: auto; /* 内容超出时可滚动 */
    }

    .pdf-column {
        flex: 1; /* 右侧占1份宽度 */
        padding: 10px;
    }

    /* 文件选择区域布局 */
    .file-input-group {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

</style>



<div class="lamp-header-section">
    <h3 class="lamp-title">@ParentProjectName -> @LampName -> @CurrentCertificateType.ToString()</h3>
    <div class="divider"></div>
</div>

<!-- 供应商列表及操作 -->
<div class="row supplier-section" style="margin-left: 2rem;">
    <div class="col-12">
        @if (Suppliers.Any())
        {
            <ul class="list-group">
                @foreach (var supplier in Suppliers)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="mdc-theme--primary">@supplier.Name</span>
                            <div class="d-flex gap-2">
                                @if(!supplier.UsingReference)
                                {
                                    <MatButton Disabled="@(CurrentReferenceMode == ReferenceMode.IsReferencing)" OnClick="@(() => EditSupplier(supplier))" Color="MatButtonColor.Info" Size="MatButtonSize.Small">编辑</MatButton>
                                    <MatButton Disabled="@(CurrentReferenceMode == ReferenceMode.IsReferencing)" OnClick="@(() => ShowImportCertDialog(supplier))" Color="MatButtonColor.Warn" Size="MatButtonSize.Small">+导入证书</MatButton>
                                }
                                
                                <MatButton Disabled="@(CurrentReferenceMode == ReferenceMode.IsReferencing)" OnClick="@(() => RemoveSupplier(supplier.Id))" Color="MatButtonColor.Warn" Size="MatButtonSize.Small">删除</MatButton>
                                @if (!supplier.UsingReference && CurrentReferenceMode == ReferenceMode.IsReferencing)
                                {
                                    <MatCheckbox @bind-Value:get="@GetSupplierIsReferenced(supplier.Id)"
                                                 Label="选择"
                                                 Class="mb-1"
                                                 @bind-Value:set="@((bool isChecked) => HandleSupplierReferenceChooseChanged(supplier, isChecked))" />
                                }

                            </div>
                        </div>
                        <!-- 显示该供应商的证书版本列表 -->                       
                        <div class="flex-grow-1">
                                <div class="border rounded h-100 bg-light d-flex flex-column">
                                    <div class="scroll-container">
                                        <div class="content-wrapper d-flex flex-wrap" style="gap: 1.5rem;">
                                        
                                        @if (supplier.CurrentCertificate != null && !string.IsNullOrEmpty(supplier.CurrentCertificateId))
                                        {
                                             <CertificateCard Certificate="@supplier.CurrentCertificate"
                                                                 IsCurrentCertificate="true"
                                                                 IsReferencing="@(supplier.UsingReference)"
                                                                 OnRemove="() => RemoveCertificate(supplier, supplier.CurrentCertificate.Id)" />
                                            @if (!supplier.UsingReference)
                                            {
                                                // Display other certificates
                                                // 在 Razor 视图中定义临时变量（局部作用域）
                                                var targetRecord = supplier.CertificateRecords?
                                                .FirstOrDefault(record => record.CertificateType == CurrentCertificateType);
                                                var targetCertificates = (targetRecord?.Certificates ?? Enumerable.Empty<Certificate>())
                                                .OrderBy(c => c.CreateTime) // 按创建时间升序排列
                                                .ToList(); // 转换为列表，避免多次枚举
                                                var hasCertificates = targetCertificates.Any();
                                                @if (hasCertificates)
                                                {                                                    
                                                    @foreach (var cert in targetCertificates)
                                                    {
                                                        <CertificateCard Certificate="@cert"
                                                                         IsCurrentCertificate="false"
                                                                         IsReferencing="@(supplier.UsingReference)"
                                                                         CertificateIndex="targetCertificates.IndexOf(cert)"
                                                                         OnRemove="() => RemoveCertificate(supplier, cert.Id)" />
                                                    }
                                                }
                                            }                                            
                                        }
                                        </div>
                                    
                                    </div>
                                </div>
                            </div>
                    </li>
                }
            </ul>
        }
        else
        {
            // <p>暂无供应商，请点击下方按钮添加。</p>
        }
        <MatButton Class="mt-3 add-first-btn" OnClick="ShowAddSupplierDialog" Color="MatButtonColor.Primary">+ 添加供应商</MatButton>
        <MatButton Class="mt-3 add-first-btn" OnClick="ShowReferenceSupplierDialog" Color="MatButtonColor.Primary"><MatIcon>link</MatIcon> 引用证书</MatButton>
    </div>
</div>

<!-- 添加供应商对话框 -->
<MatDialog @bind-IsOpen="isAddSupplierDialogVisible" CanBeClosed="false">
    <MatDialogTitle>添加供应商</MatDialogTitle>
    <MatDialogContent>
        <MatTextField @bind-Value="newSupplierName" Label="供应商名称" Required="true" />
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="CancelAddSupplier" Color="MatButtonColor.Default">取消</MatButton>
        <MatButton OnClick="ConfirmAddSupplier" Color="MatButtonColor.Primary">确认添加</MatButton>
    </MatDialogActions>
</MatDialog>

<!-- 编辑供应商对话框 -->
<MatDialog @bind-IsOpen="isEditSupplierDialogVisible" CanBeClosed="false">
    <MatDialogTitle>编辑供应商</MatDialogTitle>
    <MatDialogContent>
        <MatTextField @bind-Value="editSupplierName" Label="供应商名称" Required="true" />
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="CancelEditSupplier" Color="MatButtonColor.Default">取消</MatButton>
        <MatButton OnClick="ConfirmEditSupplier" Color="MatButtonColor.Primary">确认修改</MatButton>
    </MatDialogActions>
</MatDialog>

<!-- 添加证书版本对话框 -->
<MatDialog @bind-isOpen="isAddCertificateDialogVisible" CanBeClosed="false">
    <MatDialogTitle>添加证书版本</MatDialogTitle>
    <MatDialogContent>
        <MatTextField @bind-Value="newCertNumber" Label="证书编号/版本号" Required="true" />
        <MatDatePicker @bind-Value="newCertTime" Label="认证时间" Required="true" />
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="CancelAddCertificate" Color="MatButtonColor.Default">取消</MatButton>
        <MatButton OnClick="CancelAddCertificate" Color="MatButtonColor.Primary">确认添加</MatButton>
    </MatDialogActions>
</MatDialog>


<!-- 导入证书对话框（简单示例，实际可结合文件上传逻辑） -->
<MatDialog @bind-IsOpen="isImportCertDialogVisible" CanBeClosed="false">
    <MatDialogTitle>导入证书</MatDialogTitle>
    <MatDialogContent>
        <p>点击下方按钮选择证书文件进行导入：</p>        
        @if (!string.IsNullOrEmpty(selectedCertFilePath))
        {
            <p class="mt-2">已选择文件：@selectedCertFilePath</p>
        }
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <p class="mt-2 text-danger">@statusMessage</p>
        }
        <div class="file-input-group">
            <input type="file"
                   id="nativeFileInput"
                   accept="application/pdf"
                   class="form-control"                   
                   @ref="inputFileElement" onchange="loadPdffile(this)" />
            @* <MatButton OnClick="TriggerFileSelection" Color="MatButtonColor.Primary">选择 PDF 文件</MatButton> *@
            @* <InputFile id="fileInput" accept="application/pdf" class="form-control" OnChange="HandleFileSelected" /> *@
        </div>
        @* <InputFile id="pdfFile" OnChange="HandleFileSelected" class="form-control" maxAllowedSize="5242880" /> *@
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="CancelImportCert" Color="MatButtonColor.Default">取消</MatButton>
        <MatButton OnClick="ConfirmImportCert" Color="MatButtonColor.Primary"
                   Disabled="nativeFile == null || isProcessingImportPdf">确认导入</MatButton>
    </MatDialogActions>
</MatDialog>

<MatDialog @bind-IsOpen="@isConfirmCheck" CanBeClosed="false">
    <MatDialogTitle>确定引用当前证书？</MatDialogTitle>
    <MatDialogContent>
        您确定要继续吗？
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="OnCancelChoosenClick">取消</MatButton>
        <MatButton OnClick="OnConfirmChoosenClick">确认</MatButton>
    </MatDialogActions>
</MatDialog>

<!-- 加载状态对话框 -->
<MatDialog @bind-IsOpen="isLoadingDialogVisible" CanBeClosed="false">
    <MatDialogContent Style="text-align: center;">
        <div style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;"
             tabindex="0"></div>
            <div class="spinner"></div>
            <p class="mt-3">正在解析证书内容，请稍候...</p>
    </MatDialogContent>
</MatDialog>


<MatDialog @bind-IsOpen="@isToolTipVisible" CanBeClosed="false">
    <MatDialogTitle>警告</MatDialogTitle>
    <MatDialogContent>
       @warningContent
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="OnConfirmToopTipClick">确认</MatButton>
    </MatDialogActions>
</MatDialog>


<MatDialog @bind-IsOpen="@isWarningDialogOpen" Width="500px" CanBeClosed="false">
    <MatDialogTitle style="color: red !important;">
        <MatIcon style="color: red !important;">warning</MatIcon> 证书类型不匹配
    </MatDialogTitle>
    <MatDialogContent>
        <p>解析出的证书类型 <strong style="color: red !important;">@warningCertType</strong> 与当前选择的类型 <strong style="color: red !important;">@CurrentCertificateType</strong> 不符，请确认后重新操作。</p>
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="@(() => isWarningDialogOpen = false)" Color="MatButtonColor.Primary">
            确认
        </MatButton>
    </MatDialogActions>
</MatDialog>
<MatDialog @bind-IsOpen="@isCertAlreadyExist" Width="500px" CanBeClosed="false">
    <MatDialogTitle style="color: red !important;">
        <MatIcon style="color: red !important;">warning</MatIcon> 证书已存在
    </MatDialogTitle>
    <MatDialogContent>
        <p>@((MarkupString)certExistedErrorMsg)</p>
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="@(() => isCertAlreadyExist = false)" Color="MatButtonColor.Primary">
            确认
        </MatButton>
    </MatDialogActions>
</MatDialog>
<MatDialog @bind-IsOpen="@isSomethingError" Width="500px" CanBeClosed="false">
    <MatDialogTitle style="color: red !important;">
        <MatIcon style="color: red !important;">warning</MatIcon> @errorTitle
    </MatDialogTitle>
    <MatDialogContent>
        <p>@errorContent</p>
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="@(() => isSomethingError = false)" Color="MatButtonColor.Primary">
            确认
        </MatButton>
    </MatDialogActions>
</MatDialog>

<!-- 引用警告对话框 -->
<MatDialog @bind-IsOpen="@isReferenceWarningOpen" Width="600px" CanBeClosed="false">
    <MatDialogTitle style="color: #080808 !important;">
        <MatIcon style="color: #f57c00 !important;">warning</MatIcon> 引用警告
    </MatDialogTitle>
    <MatDialogContent>
        <p class="mb-3">@referenceWarningMessage</p>
        @if (referenceList.Any())
        {
            <div class="mt-2">
                <strong>引用列表：</strong>
                <ul style="max-height: 200px; overflow-y: auto; margin-top: 8px;">
                    @foreach (var reference in referenceList)
                    {
                        <li>@RemoveIdsFromReference(reference)</li>
                    }
                </ul>
            </div>
        }
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="@CancelDeleteWithReference" Color="MatButtonColor.Warn" FullWidth="true">
                确定
        </MatButton>
    </MatDialogActions>
</MatDialog>


