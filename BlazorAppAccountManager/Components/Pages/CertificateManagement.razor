        confirmationDialog.Message = $"您确定要删除此证书吗？此操作不可撤销。";

        try
        {
            // 调用 ShowAsync() 方法并等待用户的响应
            bool confirmed = await confirmationDialog.ShowAsync();
            if (confirmed)
            {
                // 验证输入参数是否有效
                if (supplier == null)
                    throw new ArgumentNullException(nameof(supplier), "供应商对象不能为null");

                if (string.IsNullOrEmpty(id))
                    throw new ArgumentException("认证ID不能为空", nameof(id));

                // 4. 调用服务层执行删除操作（核心逻辑转移到服务）
                var (isSuccess, errorMsg) = await CertificateService.RemoveCertificate(supplier, id);

                // 5. 处理服务返回结果
                if (isSuccess)
                {
                    Logger.LogInformation($"证书 {id} 删除成功");
                    ShowToolTip("证书删除成功");
                } else
                {
                    Logger.LogWarning($"证书 {id} 删除失败：{errorMsg}");
                    ShowToolTip($"删除失败：{errorMsg}");
                }
            }
            else
            {
                Logger.LogInformation("用户取消了删除操作");
            }
        } 
        catch(InvalidOperationException ex) 
        {
            // 捕获未预料的异常（服务层已处理大部分，此处作为兜底）
            Logger.LogError(ex, $"删除证书过程中发生未处理异常");
