    // 从引用文本中移除ID信息
    private string RemoveIdsFromReference(string reference)
    {
        // 移除常见的ID格式，如"(ID: xxxxx)"或类似模式
        // 针对灯具ID的移除
        reference = System.Text.RegularExpressions.Regex.Replace(
            reference, 
            @"\(ID: [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\)", 
            "", 
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
        );
        
        // 移除证书编号后的灯具信息中的ID
        reference = System.Text.RegularExpressions.Regex.Replace(
            reference, 
            @"灯具: (.+?)\s+\(ID: [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\)", 
            "灯具: $1", 
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
        );
        
        return reference.Trim();
    }
    
