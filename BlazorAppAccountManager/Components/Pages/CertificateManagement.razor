        return await CertificateService.CheckSupplierCertificateReferences(supplierId);
    }
    
    // 删除供应商
    private async Task RemoveSupplier(string supplierId)
    {
        // 先检查供应商的证书是否被其他项目引用
        var (hasReference, references) = await CheckSupplierCertificateReferences(supplierId);
        
        if (hasReference)
        {
            // 显示引用警告对话框 - 有引用时不允许删除
            referenceWarningMessage = "该供应商的证书已被其他灯具引用，暂时不允许删除。";
            referenceList = references;
            
            // 显示警告对话框
            isReferenceWarningOpen = true;
            return; // 提前返回
        }
        
        // 没有引用的供应商，直接显示确认对话框
        await ShowDeleteSupplierConfirmationDialog(supplierId);
    }
    
    // 统一的供应商删除确认对话框显示方法
    private async Task ShowDeleteSupplierConfirmationDialog(string supplierId)
    {
        confirmationDialog.Title = "确认删除";
        confirmationDialog.Message = $"您确定要删除此供应商吗？此操作不可撤销。";

        // 调用 ShowAsync() 方法并等待用户的响应
        bool confirmed = await confirmationDialog.ShowAsync();
        if (confirmed)
        {
            bool result = await SupplierService.DeleteSupplierAsync(supplierId);
            if (result) await LoadData();
        }
        else
        {
            Logger.LogInformation("取消删除供应商！！！");
        }
    }

