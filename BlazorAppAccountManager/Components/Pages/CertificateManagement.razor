    private void ParseCurrentVariablesByPath(Uri absoluteUri)
    {

        if (QueryHelpers.ParseQuery(absoluteUri.Query).TryGetValue("ProjectName", out var projectName))
        {
            if (!string.IsNullOrEmpty(projectName))
            {
                ParentProjectName = projectName;
            }
        }

        if (QueryHelpers.ParseQuery(absoluteUri.Query).TryGetValue("CertificateType", out var certType))
        {
            if (!string.IsNullOrEmpty(certType))
            {
                if (Enum.TryParse<CertificateType>(certType, ignoreCase: true, out var result))
                {
                    CurrentCertificateType = result;
                    Logger.LogInformation($"解析成功：{result}");
                }
                else
                {
                    Logger.LogInformation($"解析失败：{certType} 不是有效的 CertificateType");
                }
            }
        }
        else
        {
            CurrentCertificateType = CertificateType.EMark;
        }

        if (QueryHelpers.ParseQuery(absoluteUri.Query).TryGetValue("ReferenceModeValue", out var referModeValue))
        {
            if (!string.IsNullOrEmpty(referModeValue))
            {
                if (Enum.TryParse<ReferenceMode>(referModeValue, ignoreCase: true, out var result2))
                {
                    CurrentReferenceMode = result2;
                    Logger.LogInformation($"解析成功：{result2}");
                }
                else
                {
                    Logger.LogInformation($"解析失败：{referModeValue} 不是有效的 ReferenceMode");
                }
            }
        }
    }

    // 辅助方法：重置引用相关的本地存储状态
    private async Task ResetReferenceState()
    {
        await LocalStorage.SetItemAsync("CurrentReferenceMode", ReferenceMode.Normal);
        await LocalStorage.RemoveItemAsync("SupplierId"); // 清理临时存储的ID
        await LocalStorage.RemoveItemAsync("Type"); // 清理临时存储的证书类型
    }

    private async Task HandleReferenceBackIfNeeded()
    {
        try
        {
            var mode = await LocalStorage.GetItemAsync<ReferenceMode>("CurrentReferenceMode");
            if (mode != ReferenceMode.ReferenceBack)
                return;

            var supplierId = await LocalStorage.GetItemAsync<string>("SupplierId");
            if (string.IsNullOrEmpty(supplierId) || !Guid.TryParse(supplierId, out _))
            {
                Logger.LogWarning("无效的SupplierId，无法处理引用回传");
                await ResetReferenceState();
                return;
            }
            var type = await LocalStorage.GetItemAsync<CertificateType>("Type");
            if (type == null)
            {
                Logger.LogWarning("当前证书类型不支持引用回传");
                await ResetReferenceState();
                return;
            }
            // 直接调用SupplierService的方法（不再依赖ReferenceService）
            var result = await SupplierService.HandleReferenceBackAsync(type, lampId, supplierId);
            
            // 重置引用状态（无论成功与否）
            await ResetReferenceState();
            
            if (result.IsSuccess)
            {
                Logger.LogInformation("引用关系创建成功");
                await LoadData(); // 重新加载数据
                NavManager.NavigateTo(NavManager.Uri, forceLoad: true);
            }
            else
            {
                Logger.LogWarning("引用处理失败：{Message}", result.ErrorMessage);
                // 显示错误提示对话框
                errorTitle = "引用失败";
                errorContent = result.ErrorMessage;
                isSomethingError = true;
                // 强制状态更新以显示对话框
                StateHasChanged();
                // 不在这里进行页面导航，让用户先看到错误提示
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "处理引用回传时发生异常");
            await ResetReferenceState();
        }
    }

    private async Task<ReferenceMode> ParseReferenceMode()
    {
        // 安全解析枚举参数
        if (!string.IsNullOrEmpty(ReferenceModeValue))
        {
            // 尝试将字符串转换为枚举
            if (Enum.TryParse<ReferenceMode>(ReferenceModeValue, ignoreCase: true, out var parsedMode))
            {
                var  currentContext = await ReferenceService.GetCurrentContext();
                if (currentContext != null)
                {
                    parsedMode = currentContext.CurrentReferenceMode;
                }                
                return parsedMode;
            }
            else
            {
                // 处理无效值的情况（可选：记录日志或提示用户）
                Logger.LogInformation($"无效的ReferenceMode值: {ReferenceModeValue}");
                return ReferenceMode.Normal; // 回退到默认值
            }
        }
        return ReferenceMode.Normal;
    }

