            // 冲突时强制重新加载数据
            
            Suppliers = lamp?.Suppliers?.ToList() ?? new List<Supplier>();
        }
        catch (Exception ex)
        {
            Logger.LogInformation($"添加供应商失败：{ex.Message}");
            if (ex.InnerException != null)
                Logger.LogInformation($"内部错误：{ex.InnerException.Message}");
        }
        finally
        {
