    public static string GetUrlBaseUrl(string sourceUrl) 
    {
        if (string.IsNullOrEmpty(sourceUrl))
        {
            return sourceUrl;
        } 
        // 分离URL的路径和查询字符串
        var queryStringStartIndex = sourceUrl.IndexOf('?');
        string path = sourceUrl;
        string queryString = string.Empty;

        if (queryStringStartIndex >= 0)
        {
            path = sourceUrl.Substring(0, queryStringStartIndex);
            queryString = sourceUrl.Substring(queryStringStartIndex + 1);
        }
        return path;
    }

    public static string ModifyUrlParameter(string sourceUrl, string paramName, string newValue)
    {
        if (string.IsNullOrEmpty(sourceUrl))
            return sourceUrl;

        // 分离URL的路径和查询字符串
        var queryStringStartIndex = sourceUrl.IndexOf('?');
        string path = sourceUrl;
        string queryString = string.Empty;

        if (queryStringStartIndex >= 0)
        {
            path = sourceUrl.Substring(0, queryStringStartIndex);
            queryString = sourceUrl.Substring(queryStringStartIndex + 1);
        }

        // 解析查询参数
        var queryParameters = QueryHelpers.ParseQuery(queryString)
            .ToDictionary(kvp => kvp.Key, kvp => kvp.Value, StringComparer.OrdinalIgnoreCase);

        // 修改或添加参数
        queryParameters[paramName] = newValue;

        // 重新构建查询字符串
        var newQueryString = QueryHelpers.AddQueryString(string.Empty, queryParameters);

        // 组合路径和新的查询字符串
        return string.IsNullOrEmpty(newQueryString)
            ? path
            : $"{path}?{newQueryString.TrimStart('?')}";
    }


