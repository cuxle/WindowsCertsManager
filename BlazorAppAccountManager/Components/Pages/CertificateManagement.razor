    // 添加证书版本 - 确认
    private async Task ConfirmAddCertificate(Certificate cert)
    {
        if (cert == null)
        {
            Logger.LogInformation("证书对象不能为空");
            return;
        }

        if (supplierForImportCert == null || string.IsNullOrWhiteSpace(supplierForImportCert.Id))
        {
            Logger.LogInformation("供应商为空、供应商ID为空或证书编号为空");
            return;
        }

        try
        {
            // 2. 调用Service处理业务逻辑（核心逻辑全委托给Service）
            var serviceResult = await CertificateService.AddCertificateToSupplierAsync(
                cert,
                supplierForImportCert.Id,
                currentPdfDocument,
                CurrentCertificateType);

            // 3. 根据Service结果处理UI反馈
            if (!serviceResult.IsSuccess)
            {
                Logger.LogInformation($"添加证书失败：{serviceResult.ErrorMessage}");
                isCertAlreadyExist = true; // 标记证书已存在状态
                certExistedErrorMsg = serviceResult.ErrorMessage;
                return;
            }

            await LoadData();
            StateHasChanged();

            // 7. 重置表单
            newCertNumber = string.Empty;
            newCertTime = default;
        }
        catch (DbUpdateConcurrencyException ex)
        {
            // 处理并发冲突（如证书已被其他操作修改）
            Logger.LogInformation("并发冲突：数据已被修改，请刷新后重试");
            // 可选：刷新数据
            await ex.Entries.Single().ReloadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogInformation($"保存失败：{ex.Message}");
            if (ex.InnerException != null)
                Logger.LogInformation($"内部错误：{ex.InnerException.Message}");
        }
        finally
        {
            isAddCertificateDialogVisible = false;
        }       
    }

