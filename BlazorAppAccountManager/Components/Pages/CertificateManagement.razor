            if (result.Success)
            {

                Logger.LogInformation($"供应商 '{newSupplierName}' 添加成功");
                ShowToolTip("添加成功");
            } else
            {
                Logger.LogWarning($"添加失败：{result.ErrorMessage}");
                ShowToolTip(result.ErrorMessage);
            }
        }
        catch (DbUpdateConcurrencyException ex)
        {
