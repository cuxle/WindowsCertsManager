    // 加载产品列表（使用服务层处理数据访问）
    private async Task LoadProjects()
    {
        try
        {
            // 1. 获取当前用户身份信息
            var authState = await _authStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            
            // 2. 调用服务层方法获取用户认证信息
            var (currentUserId, isAdmin) = await ProjectService.GetUserAuthInfoAsync(user);

            // 3. 使用ProjectService加载项目列表
            Projects = await ProjectService.LoadProjectsAsync(currentUserId, isAdmin);

            Console.WriteLine($"Projects Count {Projects.Count}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载项目列表失败");
            Projects = new List<Project>();
        }
    }

    // 确认添加
    private async Task ConfirmAddProject()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        // 2. Check if the user ID is valid
        if (string.IsNullOrEmpty(userId))
        {
            // Handle the case where the user is not logged in
            // For example, by redirecting to the login page or showing an error.
            return;
        }

        // 3. Set the CreatorId of your entity before saving
        newProject.CreatorId = userId;

        // 重置验证状态
        isAddProjectValidationFailed = false;

        // 验证逻辑：检查时间是否未选择
        if (newProject.SopTime == default(DateTime) || string.IsNullOrEmpty(newProject.Name))
        {
            isAddProjectValidationFailed = true;  // 触发错误状态
            return;  // 不执行后续添加逻辑
        }

        if (!string.IsNullOrWhiteSpace(newProject.Name))
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var existingProject = await db.Projects
                .FirstOrDefaultAsync(p => p.Name == newProject.Name && p.CreatorId == userId);

            if (existingProject != null)
            {
                isSomethingError = true;
                errorTitle = "项目已存在";
                errorContent = $"项目名称 '{newProject.Name}' 已存在，请使用其他名称。";
                return;
            }

            db.Projects.Add(newProject); // 添加到DbContext
            await db.SaveChangesAsync(); // 保存到数据库            

            isAddProjectDialogVisible = false;            

            await LoadProjects();

            await JSRuntime.InvokeVoidAsync("scrollToLatestProject");

            // CurrentReferenceMode = ParseReferenceMode(); 解析引用模式参数
            CurrentCertificateType = await LocalStorage.GetItemAsync<CertificateType>("CurrentCertificateType");

            // 原则上引用模式先，只需要显示可以引用的灯，不可以引用的灯不显示就行了
            await SelectCategory(CurrentCertificateType);

            StateHasChanged();
        }
    }

    // 确认添加
    private async Task ConfirmAddLamp()
    {
        isAddItemValidationFailed = false;
        // 验证逻辑：检查灯名称是否为空
        if (string.IsNullOrEmpty(selectedLampType))
        {
            isAddItemValidationFailed = true;  // 触发错误状态
            return;  // 验证失败，不执行添加逻辑
        }
        newLamp.Name = selectedLampType;

        using var db = await DbFactory.CreateDbContextAsync();
        try
        {         
            if (currentProject == null)
            {
                // 无效输入或无当前项目，直接退出
                isAddItemDialogVisible = false;
                return;
            }

            // 检查是否存在同名未删除的Lamp
            var existingLamp = currentProject.Lamps.FirstOrDefault(l => l.Name == newLamp.Name);

            if (existingLamp != null)
            {
                // 如果存在已删除的同名Lamp，恢复它
                if (existingLamp.IsDeleted)
                {
                    existingLamp.IsDeleted = false;
                    db.Lamps.Update(existingLamp); // 只更新需要修改的实体
                } else
                {
                    // 如果没有删除呢，弹出错误警告
                    isSomethingError = true;
                    errorTitle = "灯已存在";
                    errorContent = $"灯 '{newLamp.Name}' 已存在。";

                }
            }
            else
            {
                // 新增Lamp并关联到当前项目
                newLamp.ProjectId = currentProject.Id; // 显式设置外键
                db.Lamps.Add(newLamp);
                currentProject.Lamps.Add(newLamp); // 保持内存中对象图一致
            }
            // 只有在有变更时才保存
            await db.SaveChangesAsync();
        } 
        catch (DbUpdateConcurrencyException ex)
        {
            // 处理并发冲突
            Logger.LogInformation($"并发冲突: {ex.Message}");
            // 可选：重新加载数据并提示用户重试
            // await ReloadData(); // 自定义方法重新加载数据
            // 显示提示："数据已被修改，请刷新后重试"
        }
        catch (Exception ex)
        {
            Logger.LogInformation($"添加Lamp出错: {ex.Message}");
        }
        finally
        {
            isAddItemDialogVisible = false;
            // 移除finally中的SaveChanges，避免无效保存
        }
    }

    private async Task GenerateSheetOfProject(IWorkbook workbook, Project project)
    {
        if (workbook == null || project == null) return;

        // 2. 创建工作表
        ISheet sheet = workbook.CreateSheet(project.Name);
        int rowIndex = 0;
        // 3. 创建表头行
        IRow headerRow = sheet.CreateRow(rowIndex++);
        headerRow.CreateCell(0).SetCellValue("项目名称");
        headerRow.CreateCell(1).SetCellValue(project.Name);

        IRow headerRow1 = sheet.CreateRow(rowIndex++);
        headerRow1.CreateCell(0).SetCellValue("SOP时间");
        headerRow1.CreateCell(1).SetCellValue(project.SopTime.ToString("yyyy-MM-dd"));

        foreach (CertificateType certType in Enum.GetValues(typeof(CertificateType)))
        {
            if (certType == CertificateType.Other)
            {
                continue;
            }
            IRow emptyRow = sheet.CreateRow(rowIndex++);
            IRow cerTypeRow = sheet.CreateRow(rowIndex++);
            cerTypeRow.CreateCell(0).SetCellValue("证书类型");
            cerTypeRow.CreateCell(1).SetCellValue(certType.ToString());

            IRow supplierRow = sheet.CreateRow(rowIndex++);
            int supplierIndex = 0;
            supplierRow.CreateCell(supplierIndex++).SetCellValue("产品名称");
            for (int i = 0; i < 10; i++)
            {
                supplierRow.CreateCell(supplierIndex++).SetCellValue("证书编号");
                supplierRow.CreateCell(supplierIndex++).SetCellValue("证书版本");
            }

            using var db = await DbFactory.CreateDbContextAsync();

            // 遍历每个 Lamp 对象，填充数据行
            for (int i = 0; i < project.Lamps.Count; i++)
            {
                var lamp = project.Lamps[i];
                IRow row = sheet.CreateRow(rowIndex++);

                int columnIndex = 0;
                row.CreateCell(columnIndex++).SetCellValue(lamp.Name);

                int numberIndex = 1;
                // 关键修正: 直接从 Lamp 对象获取 CurrentCertificate
                // 近光灯  Number1， Version1， Number2, Version2
                foreach (var supplier in lamp.Suppliers)
                {
                    string supplierName = supplier.Name;
                    CertificateRecord record = supplier.CertificateRecords.FirstOrDefault(s => s.CertificateType == certType);
                    if (record != null && !string.IsNullOrEmpty(record.LatestCertificateId))
                    {
                        Certificate certificate = await db.Certificates.FirstOrDefaultAsync(s => s.Id == record.LatestCertificateId);
                        if (certificate != null)
                        {
                            string certName = $"{supplierName}:{certificate.Number}";
                            string certVersion = certificate.Version;
                            row.CreateCell(columnIndex++).SetCellValue(certName);
                            row.CreateCell(columnIndex++).SetCellValue(string.IsNullOrEmpty(certVersion) ? "无" : certVersion);
                        }
                    }
                }
            }

        }
    }


    private async Task ExportTable(Project project)
    {
        IWorkbook workbook = new XSSFWorkbook();

        await GenerateSheetOfProject(workbook, project);

        // 写入内存流
        using (MemoryStream ms = new MemoryStream())
        {
            workbook.Write(ms);
            var bytes = ms.ToArray();

            // 关键修正: 使用 JS 互操作触发下载
            await JSRuntime.InvokeVoidAsync("saveAsFile", $"{project.Name}_证书信息.xlsx", Convert.ToBase64String(bytes));
        }
    }

