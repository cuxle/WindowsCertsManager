                    @if (LampsOfCar != null)
                    {
                        @foreach (var type in LampsOfCar)
                        {
                            <MatOption Value="@type.Name">@type.Name</MatOption>
                        }
                    }

            </MatSelect>
        </div>
    </div>
</MatDialogContent>
<MatDialogActions>
    <MatButton OnClick="CancelAddLamp" Color="MatButtonColor.Default">取消</MatButton>
    <MatButton OnClick="ConfirmAddLamp" Color="MatButtonColor.Primary">确认添加</MatButton>
</MatDialogActions>
</MatDialog>

<MatDialog @bind-IsOpen="@isSomethingError" Width="500px" CanBeClosed="false">
    <MatDialogTitle style="color: red !important;">
        <MatIcon style="color: red !important;">warning</MatIcon> @errorTitle
    </MatDialogTitle>
    <MatDialogContent>
        <p>@errorContent</p>
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="@(() => isSomethingError = false)" Color="MatButtonColor.Primary">
            确认
        </MatButton>
    </MatDialogActions>
</MatDialog>

<script>
    window.scrollToLatestProject = function () {
        const container = document.getElementById('projectScrollContainer');
        if (container) {
        // 使用requestAnimationFrame确保在DOM更新后执行
        requestAnimationFrame(() => {
            container.scrollTo({
                left: container.scrollWidth,
                behavior: 'smooth' // 平滑滚动
            });
        });
    }
    };

    // This function will be called from your Blazor component
    function saveAsFile(filename, bytesBase64) {
        const link = document.createElement('a');
        link.href = "data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64," + bytesBase64;
        link.download = filename;
        link.click();
    }
</script>
@code {
    [Inject]
    public IMatDialogService MatDialogService { get; set; }
    private bool isAddProjectDialogVisible = false;
    private bool isAddItemDialogVisible = false;

    private bool isAddProjectValidationFailed;
    private bool isAddItemValidationFailed;

    private string selectedLampType;

    private bool isSomethingError = false;
    private string errorTitle = "发生错误";
    private string errorContent = "操作过程中发生错误，请稍后重试。";

    [Parameter]
    [SupplyParameterFromQuery]
    public string ReferenceModeValue { get; set; } // 接收"引用模式"参数

    public CertificateType CurrentCertificateType { get; set; } = CertificateType.Other; // 默认选择 EMark
    private ReferenceMode _currentReferenceMode = ReferenceMode.Normal;
    public ReferenceMode CurrentReferenceMode 
    { 
        get { return _currentReferenceMode; }
        set 
        { 
            if (_currentReferenceMode != value)
            {
                _currentReferenceMode = value;
                // 当引用模式变化时，更新源灯具名称并刷新UI
                if (_currentReferenceMode == ReferenceMode.IsReferencing)
                {
                    _ = UpdateSourceLampNameAndRefreshUI();
                }
                else
                {
                    SourceLampName = null; // 重置源灯具名称缓存
                }
            }
        }
    } // 接收"引用模式"参数

    // 缓存源灯具名称，用于UI显示控制
    private string SourceLampName { get; set; } = null;

    private List<string> CarLampNames = new List<string>() { "远光", "近光", "前雾灯", "昼间行驶灯", "前位置灯", "前转向灯", "角灯", "制动灯", "后转向灯", "后位置灯",
        "倒车灯", "后雾灯", "高位制动灯", "牌照灯"};

    // 定义灯名的优先级字典（提高查询效率）
    private Dictionary<string, int> lampPriority;

    private List<Lamp> LampsOfCar;

    private bool isUiStateLoaded = false;

    protected override async Task OnInitializedAsync()
    {
        LampsOfCar = await GenerateLampsOfCar();        
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 加载项目数据
        await LoadProjects();

        Console.WriteLine($"Project Count AfterRender:{Projects.Count}");
        // 每次渲染都检查引用模式和更新源灯具名称，确保UI正确显示
        if (CurrentReferenceMode == ReferenceMode.IsReferencing)
        {
            await UpdateSourceLampName();
        }

        if (firstRender)
        {
            // 首次渲染时获取当前路径和上下文
            var currentPath = NavManager.ToAbsoluteUri(NavManager.Uri).PathAndQuery;
            var currentContext = await ReferenceService.GetCurrentContext();

            // 初始化默认配置
            if (currentContext != null)
            {
                if (currentPath == "/" || currentPath == "")
                {
                    await LocalStorage.SetItemAsync("CurrentReferenceMode", ReferenceMode.Normal);
                    currentContext.CurrentReferenceMode = ReferenceMode.Normal;
                    await ReferenceService.SaveContext(currentContext);
                }
            }

            // 从本地存储加载证书类型和引用模式

            CurrentReferenceMode = await LocalStorage.GetItemAsync<ReferenceMode>("CurrentReferenceMode");


            CurrentCertificateType = await LocalStorage.GetItemAsync<CertificateType>("CurrentCertificateType");

            // 选择证书类型并刷新UI
            await SelectCategory(CurrentCertificateType);

            isUiStateLoaded = true;

            // 强制刷新UI以显示加载的数据
            StateHasChanged();
        }
    }
    
    // 更新源灯具名称缓存
    private async Task UpdateSourceLampName()
    {
        var currentContext = await ReferenceService.GetCurrentContext();
        if (currentContext != null && !string.IsNullOrEmpty(currentContext.SourceLampId))
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var sourceLamp = await db.Lamps.FirstOrDefaultAsync(l => l.Id == currentContext.SourceLampId);
            if (sourceLamp != null)
            {
                SourceLampName = sourceLamp.Name;
            }
        }
    }
    
    // 更新源灯具名称并刷新UI（非阻塞调用）
    private async Task UpdateSourceLampNameAndRefreshUI()
    {
        await UpdateSourceLampName();
        StateHasChanged();
    }

    private ReferenceMode ParseReferenceMode()
    {
        // 安全解析枚举参数
        if (!string.IsNullOrEmpty(ReferenceModeValue))
        {
            // 尝试将字符串转换为枚举
            if (Enum.TryParse<ReferenceMode>(ReferenceModeValue, ignoreCase: true, out var parsedMode))
            {
                return parsedMode;
            }
            else
            {
                // 处理无效值的情况（可选：记录日志或提示用户）
                Logger.LogInformation($"无效的ReferenceMode值: {ReferenceModeValue}");
                return ReferenceMode.Normal; // 回退到默认值
            }
        }
        return ReferenceMode.Normal; 
    }

    private async Task<List<Lamp>> GenerateLampsOfCar()
    {
        var db = await DbFactory.CreateDbContextAsync();
        var LampTemplates = await db.LampTemplates.OrderBy(l => l.SortOrder).ToListAsync();
        var lamps = new List<Lamp>();
        foreach (var lampTemp in LampTemplates)
        {
            Lamp newLamp = new();
            newLamp.Name = lampTemp.Name;
            newLamp.Suppliers = new List<Supplier>();
            newLamp.SortOrder = lampTemp.SortOrder;
            lamps.Add(newLamp);
        }
        return lamps;
    }

    private async void NavigateWithRouteParameter((Project project, Lamp item) parameters)
    {
        var (project, item) = parameters;
        
        // 引用模式下，检查灯具名称是否匹配
        if (CurrentReferenceMode == ReferenceMode.IsReferencing)
        {
            var currentContext = await ReferenceService.GetCurrentContext();
            if (currentContext != null && !string.IsNullOrEmpty(currentContext.SourceLampId))
            {
                // 获取源灯具信息
                using var db = await DbFactory.CreateDbContextAsync();
                var sourceLamp = await db.Lamps.FirstOrDefaultAsync(l => l.Id == currentContext.SourceLampId);
                
                // 验证灯具名称是否相同
                if (sourceLamp != null && sourceLamp.Name != item.Name)
                {
                    // 显示错误提示
                    isSomethingError = true;
                    errorTitle = "引用限制";
                    errorContent = "只能引用相同名称的灯具证书";
                    StateHasChanged();
                    return;
                }
            }
        }
        
        // 跳转到目标页面并在路由中携带参数
        NavigationManager.NavigateTo($"/certificate-management/{item.Id}?ReferenceModeValue={CurrentReferenceMode.ToString()}&ProjectName={project.Name}&CertificateType={selectedCategory}");
    }

    private Project newProject = new();
    private Lamp newLamp = new();
    private Project currentProject = null;
    private bool isProcessing = false; // 用于防止并发操作的标志位
    [Inject]
    private AuthenticationStateProvider _authStateProvider { get; set; }

    // 显示添加对话框
    private async Task ShowAddProjectDialog()
    {
        newProject = new Project(); // 重置新项目对象
        newProject.Lamps = await GenerateLampsOfCar();
        newProject.CreateTime = DateTime.Now;
        isAddProjectDialogVisible = true;
    }

    public List<Project> Projects { get; set; } = new List<Project>();

    public void AddProjectLamp(Project project)
    {
        if (project != null)
        {
            newLamp = new();
            isAddItemDialogVisible = true;
            currentProject = project;
        }
    }

    private async void RemoveProjectCard(string projectId)
    {
        var itemToRemove = Projects.FirstOrDefault(p => p.Id == projectId);
        if (itemToRemove != null)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var projectToDelete = await db.Projects
                    .FirstOrDefaultAsync(p => p.Id == projectId); // 从数据库重新获取，避免使用内存中的实体
            if (projectToDelete != null)
            {
                db.Projects.Remove(projectToDelete);
                await db.SaveChangesAsync(); // 保存删除操作
            }
            await LoadProjects(); // 重新加载项目列表           
        }
        StateHasChanged();
    }

    // 删除单项数据
    private async Task RemoveSingleItem((Project project, Lamp lamp) parameters)
    {
        var (project, lamp) = parameters;
        
        if (project != null && lamp != null)
        {
            using var db = await DbFactory.CreateDbContextAsync();

            // 1. 先查询完整的 lamp 及其关联的 Suppliers（确保加载关联数据）
            var lampToUpdate = await db.Lamps
                .Include(l => l.Suppliers) // 加载关联的供应商
                .FirstOrDefaultAsync(l => l.Id == lamp.Id);

            if (lampToUpdate == null)
            {
                Logger.LogInformation($"未找到ID为 {lamp.Id} 的灯");
                return;
            }

            // 2. 删除关联的所有供应商（从数据库中移除）
            if (lampToUpdate.Suppliers != null && lampToUpdate.Suppliers.Any())
            {
                db.Suppliers.RemoveRange(lampToUpdate.Suppliers); // 从数据库删除
            }

            lampToUpdate.IsDeleted = true;
            lamp.IsDeleted = true;
            db.Lamps.Update(lampToUpdate);

            await db.SaveChangesAsync(); // 保存到数据库
        }
        StateHasChanged(); // 通知 Blazor 更新 UI 
    }

    private string GetButtonStyle(Lamp lamp)
    {
        // 基础样式
        var baseStyle = "height: 30px; align-items: center; min-width:110px; white-space: nowrap; padding: 0 16px;";

        // 条件样式
        if (!lamp.IsDeleted && lamp?.CurrentTypeCerts?.Count > 0)
        {
            baseStyle += " background-color: green; color: white;";
        }

        // 引用模式下，检查灯具名称是否匹配
        if (CurrentReferenceMode == ReferenceMode.IsReferencing)
        {
            // 检查源灯具名称是否与当前灯具名称匹配
            if (!IsSameLampName(lamp))
            {
                // 不同名灯具置灰样式
                baseStyle += " background-color: #e0e0e0; color: #9e9e9e; cursor: not-allowed;";
            }
        }

        return baseStyle;
    }

    private bool IsSameLampName(Lamp lamp)
    {
        // 使用缓存的源灯具名称进行比较
        if (CurrentReferenceMode == ReferenceMode.IsReferencing && !string.IsNullOrEmpty(SourceLampName))
        {
            return SourceLampName == lamp.Name;
        }
        return true; // 非引用模式下所有灯具都可点击
    }

    private void HandleButtonClick(Project item, string propertyName)
    {
        // 根据 propertyName 执行不同的操作
        switch (propertyName)
        {
            case "SopTime":
                // 处理 SOP时间 按钮点击
                Logger.LogInformation($"点击了 {item.SopTime} 的按钮");
                break;
            case "FarLightCertNo":
