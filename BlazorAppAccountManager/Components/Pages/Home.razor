    public async Task HandleUpdateDisplay(CertificateType type)
    {
        // 一次性创建数据库上下文，避免在循环中重复创建
        using var db = await DbFactory.CreateDbContextAsync();
        
        // 预加载所有需要的证书信息和证书记录，减少单独查询
        var allCertificates = await db.Certificates.ToListAsync();
        var allCertificateRecords = await db.CertificateRecords.ToListAsync();
        
        // 创建证书记录ID到记录的映射，方便快速查找
        var certificateRecordMap = allCertificateRecords.ToDictionary(cr => cr.Id, cr => cr);
        
        foreach (var project in Projects)
        {
            foreach (var lamp in project.Lamps)
            {
                // 初始化证书列表
                lamp.CurrentTypeCerts = new List<Certificate>();
                
                // 检查灯具是否有供应商
                if (lamp.Suppliers?.Any() != true)
                {
                    lamp.CurrentContent = string.Empty;
                    continue;
                }
                
                // 过滤需要处理的供应商（跳过引用模式下使用引用的供应商）
                var relevantSuppliers = lamp.Suppliers
                    .Where(s => !(CurrentReferenceMode == ReferenceMode.IsReferencing && s.UsingReference))
                    .ToList();
                
                // 收集所有需要的证书记录，包括处理引用关系
                var latestCertificateIds = new List<string>();
                
                foreach (var supplier in relevantSuppliers)
                {
                    if (supplier.CertificateRecords != null)
                    {
                        var certificateRecord = supplier.CertificateRecords
                            .FirstOrDefault(record => record.CertificateType == type);
                        
                        if (certificateRecord != null)
                        {
                            // 处理证书记录引用关系
                            var finalRecord = GetFinalCertificateRecord(certificateRecord, certificateRecordMap);
                            
                            if (finalRecord != null && !string.IsNullOrEmpty(finalRecord.LatestCertificateId))
                            {
                                latestCertificateIds.Add(finalRecord.LatestCertificateId);
                                Logger.LogDebug($"灯具 {lamp.Name} - 供应商 {supplier.Name} 的最终证书记录ID: {finalRecord.Id}, 最新证书ID: {finalRecord.LatestCertificateId}");
                            }
                        }
                    }
                }
                
                // 批量获取证书，而不是逐个查询
                var relevantCertificates = allCertificates
                    .Where(cert => latestCertificateIds.Contains(cert.Id))
                    .ToList();
                
                // 更新灯具的证书列表
                lamp.CurrentTypeCerts.AddRange(relevantCertificates);
                
                // 生成并更新当前内容
                if (relevantCertificates.Any())
                {
                    lamp.CurrentContent = string.Join(Environment.NewLine, 
                        relevantCertificates.Select(cert => cert.Number));
                    Logger.LogInformation($"灯具 {lamp.Name} 的证书内容: {lamp.CurrentContent}");
                }
                else
                {
                    lamp.CurrentContent = string.Empty;
                    Logger.LogDebug($"灯具 {lamp.Name} 没有找到类型为 {type} 的证书");
                }
            }
        }
    }
    
    // 递归获取最终的证书记录，处理引用关系
    private CertificateRecord? GetFinalCertificateRecord(CertificateRecord record, Dictionary<string, CertificateRecord> recordMap)
    {
        // 如果当前记录没有使用引用，直接返回
        if (!record.UsingReference || string.IsNullOrEmpty(record.ReferenceCertificateRecordId))
        {
            return record;
        }
        
        // 如果引用的记录存在，则递归查找
        if (recordMap.TryGetValue(record.ReferenceCertificateRecordId, out var referencedRecord))
        {
            // 防止循环引用，最多递归3次
            return GetFinalCertificateRecord(referencedRecord, recordMap, 1);
        }
        
        // 如果引用的记录不存在，返回当前记录
        Logger.LogWarning($"证书记录 {record.Id} 引用的记录 {record.ReferenceCertificateRecordId} 不存在");
        return record;
    }
    
    // 递归实现，带深度限制
    private CertificateRecord? GetFinalCertificateRecord(CertificateRecord record, Dictionary<string, CertificateRecord> recordMap, int depth)
    {
        // 限制递归深度，防止无限循环
        if (depth >= 3)
        {
            Logger.LogWarning($"证书记录引用链超过最大深度(3)，可能存在循环引用");
            return record;
        }
        
        // 如果当前记录没有使用引用，直接返回
        if (!record.UsingReference || string.IsNullOrEmpty(record.ReferenceCertificateRecordId))
        {
            return record;
        }
        
        // 如果引用的记录存在，则递归查找
        if (recordMap.TryGetValue(record.ReferenceCertificateRecordId, out var referencedRecord))
        {
            return GetFinalCertificateRecord(referencedRecord, recordMap, depth + 1);
        }
        
        // 如果引用的记录不存在，返回当前记录
        Logger.LogWarning($"证书记录 {record.Id} 引用的记录 {record.ReferenceCertificateRecordId} 不存在");
        return record;
    }
    
