@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using BlazorAppAccountManager.Components.Data
@using BlazorAppAccountManager.Components.Models
@using BlazorAppAccountManager.Components.Services
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc
@using NPOI.SS.UserModel
@using NPOI.XSSF.UserModel
@using System.Text
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore;
@inject NavigationManager NavManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject CertificateReferenceService ReferenceService
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILocalStorageService LocalStorage
@inject ILogger<Home> Logger
@inject SupplierService SupplierService
@inject ProjectService ProjectService

@attribute [Authorize]

<style>   

.scroll-container {
    /* 限制宽度（可根据设计需求调整，比如设为 100% 容器宽度或固定最大宽度） */
    width: 100%;
    max-width: calc(100vw - 2rem); /* 可选：减去左右边距，避免贴边 */
    overflow-x: auto; /* 仅水平方向超出时显示滚动条 */
    overflow-y: hidden; /* 垂直方向不滚动 */
    display: flex;
    flex-direction: row;
    gap: 15px; /* 卡片之间的间距 */
    padding: 10px 0; /* 可选：上下内边距 */
}

.content-wrapper {
    /* 关键：使用 Flexbox 让子元素水平排列 */
    display: flex;
    /* 防止子元素换行 */
    flex-wrap: nowrap;
    /* 确保内容包裹器的高度是自动的，以适应scroll-container */
    height: 100%;
}

.info-row {
    display: flex;
    align-items: center;
    margin-bottom: 2px;
}

.info-label {
    align-items:center;
    font-weight: bold;
    flex-shrink: 0;
    margin-right: 8px;
}

.info-value {
    flex-grow: 1;
    padding: 5px 10px;
    border: 1px solid #ced4da;
    border-radius: 4px;
    background-color: #fff;
    font-size: 0.9em;
}

.delete-btn-container {
    display: flex;
    justify-content: flex-end;
    margin-top: 10px;
}

.bordered-button {
    border: 1px solid #ccc; /* 边框宽度、样式、颜色 */
    border-radius: 4px; /* 可选：添加圆角使边框更美观 */
    padding: 6px 16px; /* 可选：调整内边距，确保边框与文字距离合适 */
}

/* 可选：添加hover效果 */
.bordered-button:hover {
    border-color: #666; /* 鼠标悬停时边框颜色变化 */
}

.bg-light-green {
    min-height: 40px;
    /* 浅绿色背景 */
    background-color: #c3e6cb;
    /* 可选：添加一点内边距和圆角，让样式更美观 */
    padding: 2px 8px;
    border-radius: 4px;
}
/* 为每一行设置 Grid 布局 */
.item-row {
    display: grid;
    grid-template-columns: 65px auto max-content; /* 第一列固定宽度，第二列自适应，第三列按内容 */
    gap: 3px;
    align-items: center;
}    
.flex-container {
    /* 让容器占据整个视口高度 */
    height: 100vh;
    display: flex;
    flex-direction: column;
}
/* 1. 水平滚动容器的 CSS */
.scroll-container-horizontal {
    /* 移除 min-width: max-content;
        因为 flex-row 默认会把内容排成一行，
        只要父容器 overflow-x: auto 即可 */
    gap: 1.5rem;
    padding: 0.5rem 0;
}

/* 2. 项目卡片垂直滚动区域的 CSS */
.card-scroll-area {
    /* min-height 确保即使内容很少也能撑开 */
    min-height: 100px;
    /* 限制最大高度，以防卡片无限增长 */
    max-height: 300px;
    /* 隐藏水平滚动条，只保留垂直滚动 */
    overflow-x: hidden;
}

/* 3. 优化卡片样式 */
.project-card {
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 8px;
    min-width: 340px;
    background-color: #fff;
    overflow-y:auto;
}

.fixed-width-btn {
    /* 设置固定宽度（根据内容长度调整，例如120px） */
    width: 100px;
    /* 禁止文字换行，确保内容在一行显示 */
    white-space: nowrap;
    /* 可选：文字居中对齐（部分组件可能默认左对齐） */
    text-align: center;
    /* 可选：限制最小宽度，防止内容溢出 */
    min-width: 120px;
}

</style>

<div class="min-vh-100 d-flex flex-column  ps-5">
@if (isUiStateLoaded)
{
    <div class="my-1 flex-shrink-0">
        <!-- 上方按钮行 -->
        <div class="mb-2 d-flex gap-3 flex-wrap">
            <MatButton class="fixed-width-btn" Raised="@(selectedCategory == CertificateType.EMark)" OnClick="@(() => SelectCategory(CertificateType.EMark))" Color="MatButtonColor.Primary">
                EMark
            </MatButton>
                <MatButton class="fixed-width-btn" Raised="@(selectedCategory == CertificateType.CCC)" OnClick="@(() => SelectCategory(CertificateType.CCC))" Color="MatButtonColor.Accent">
                CCC
            </MatButton>
                <MatButton class="fixed-width-btn" Raised="@(selectedCategory == CertificateType.强检)" OnClick="@(() => SelectCategory(CertificateType.强检))" Color="MatButtonColor.Accent">
                强检
            </MatButton>
                <MatButton class="fixed-width-btn" Raised="@(selectedCategory == CertificateType.自我声明)" OnClick="@(() => SelectCategory(CertificateType.自我声明))" Color="MatButtonColor.Accent">
                自我声明
            </MatButton>
                <MatButton class="fixed-width-btn" Raised="@(selectedCategory == CertificateType.自愿性认证)" OnClick="@(() => SelectCategory(CertificateType.自愿性认证))" Color="MatButtonColor.Accent">
                自愿性认证
            </MatButton>
            <!-- 添加弹性间隔元素，将第三个按钮推到右侧 -->
            <div class="flex-grow-1"></div>
            @* <MatButton OnClick="ShowAddDialog" Color="MatButtonColor.Accent">
                <MatIcon>add_circle</MatIcon>
                    添加项目
            </MatButton> *@
        </div>
    </div>
    @* 下方内容区域 *@
    @* 下方内容区域 - 关键修改：限制宽度并隐藏溢出 *@
    <div class="flex-container flex-grow-1 mb-2">
        <div class="border rounded p-3 h-100 bg-light d-flex flex-column overflow-x-hidden">
            <div class="d-flex align-items-start justify-content-end mb-1">
                <MatButton OnClick="ShowAddProjectDialog" Color="MatButtonColor.Accent">
                    <MatIcon>add_circle</MatIcon>
                    添加项目
                </MatButton>
                <AuthorizeView Roles="Admin">
                    <MatButton OnClick="ExportAllProjects" Color="MatButtonColor.Accent">
                        <MatIcon>file_download</MatIcon>
                        导出所有
                    </MatButton>
                </AuthorizeView>
            </div>
            <!-- 项目展示容器 - 仅此处出现滚动条 -->
            @* <div class="scroll-container" id="projectScrollContainer" style="transform: rotateX(180deg);"> *@
            <div id="projectScrollContainer" class="scroll-container d-flex flex-row overflow-x-auto flex-grow-1" style="transform: rotateX(180deg);">
                <div class="content-wrapper" style="gap: 1.5rem; min-width: max-content; padding: 0.5rem 0; transform: rotateX(180deg);">
                    @foreach (var project in Projects)
                    {
                        <div class="project-card parent-container d-flex flex-column "  style="padding: 8px 8px; min-width:340px">
                            <div class="info-row bg-light-green d-flex justify-content-center align-items-center">
                                <span class="info-label">@project.Name</span>
                            </div>
                            <div class="info-row">
                                <span class="info-label" style="min-width:105px; text-align: center;">SOP时间:</span>
                                <div class="info-value">@project.SopTime.ToString("yyyy-MM-dd")</div>
                            </div>

                            @foreach (var lamp in project.Lamps)
                            {
                                <LampItem Lamp="@lamp"
                                         Project="@project"
                                         NavigateWithRouteParameter="@NavigateWithRouteParameter"
                                         RemoveSingleItem="@RemoveSingleItem"
                                         GetButtonStyle="@GetButtonStyle"
                                         IsDisabled="@(CurrentReferenceMode == ReferenceMode.IsReferencing && !IsSameLampName(lamp))" />
                                
                            }

                            <div>
                                <div class="mt-1 d-flex gap-3">
                                    <MatButton OnClick="() => AddProjectLamp(project)"
                                                Color="MatButtonColor.Danger"
                                                Size="MatButtonSize.Small">
                                        <MatIcon>add</MatIcon> 添加
                                    </MatButton>
                                    <MatButton OnClick="() => RemoveProjectCard(project.Id)"
                                                Color="MatButtonColor.Danger"
                                                Size="MatButtonSize.Small">
                                        <MatIcon>delete</MatIcon> 删除本项目
                                    </MatButton>
                                </div>
                                <div class="mt-1">
                                    <MatButton OnClick="()=>ExportTable(project)" Color="MatButtonColor.Primary">
                                        <MatIcon>file_download</MatIcon> 导出表格
                                    </MatButton>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>           
        </div>
    </div>
}
</div>

<!-- 添加项目的对话框 -->
<MatDialog @bind-IsOpen="isAddProjectDialogVisible" CanBeClosed="false">
<MatDialogTitle>添加新项目</MatDialogTitle>
<MatDialogContent>
    <div class="space-y-4">
        <!-- 项目名称输入 -->
        <div>
            <MatLabel>项目名称</MatLabel>
            <MatTextField 
                @bind-Value="newProject.Name" 
                Label="请输入项目名称" 
                Required="true"
                onerror="@(string.IsNullOrEmpty(newProject.Name) && isAddProjectValidationFailed)"
                ErrorText="请输入项目名称" />
        </div>

        <!-- Release时间选择 -->
        <div>
            <MatLabel>SOP时间</MatLabel>
            <MatDatePicker @bind-Value="newProject.SopTime"
                            Label="选择发布日期" 
                            Required="true"
                            Error="@(newProject.SopTime == default(DateTime) && isAddProjectValidationFailed)"
                            ErrorText="请选择发布日期" />
        </div>
    </div>
</MatDialogContent>
<MatDialogActions>
    <MatButton OnClick="CancelAdd" Color="MatButtonColor.Default">取消</MatButton>
    <MatButton OnClick="ConfirmAddProject" Color="MatButtonColor.Primary">确认添加</MatButton>
</MatDialogActions>
</MatDialog>


<!-- 添加单个项目内容对话框 -->
<MatDialog @bind-IsOpen="isAddItemDialogVisible" CanBeClosed="false">
<MatDialogTitle>添加功能</MatDialogTitle>
<MatDialogContent>
    <div class="space-y-4">
        <!-- 项目名称输入 -->
        <div>
            <MatLabel>灯名称</MatLabel>
            @* <MatTextField @bind-Value="newLamp.Name"
                            Label="请输入车灯名称" 
                            Error="@(string.IsNullOrEmpty(newLamp.Name) && isAddItemValidationFailed)"
                            Required="true" /> *@
            <MatSelect @bind-Value="selectedLampType"
                        Label="请选择车灯类型"
