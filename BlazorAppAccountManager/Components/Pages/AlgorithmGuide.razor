                <!-- 堆 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#heap">
                            6. 堆 (Heap)
                        </button>
                    </h2>
                    <div id="heap" class="accordion-collapse collapse" data-bs-parent="#dataStructuresAccordion">
                        <div class="accordion-body">
                            <p><strong>特点：</strong></p>
                            <ul>
                                <li>完全二叉树</li>
                                <li>最大堆/最小堆</li>
                                <li>插入/删除 O(log n)</li>
