@page "/algorithm-guide"
@rendermode InteractiveServer

<PageTitle>数据结构与算法面试指导</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">数据结构与算法面试指导</h1>
    <p class="lead">全面的数据结构与算法面试准备指南</p>

    <!-- 基础数据结构 -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h2 class="h4 mb-0">一、基础数据结构</h2>
        </div>
        <div class="card-body">
            <div class="accordion" id="dataStructuresAccordion">
                <!-- 数组 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#arrays">
                            1. 数组 (Arrays)
                        </button>
                    </h2>
                    <div id="arrays" class="accordion-collapse collapse show" data-bs-parent="#dataStructuresAccordion">
                        <div class="accordion-body">
                            <p><strong>特点：</strong></p>
                            <ul>
                                <li>连续内存存储</li>
                                <li>随机访问时间复杂度 O(1)</li>
                                <li>插入/删除时间复杂度 O(n)</li>
                            </ul>
                            <p><strong>常见算法：</strong></p>
                            <ul>
                                <li>双指针技术</li>
                                <li>滑动窗口</li>
                                <li>前缀和</li>
                            </ul>
                            <p><strong>典型题目：</strong>两数之和、三数之和、最大子数组和</p>
                        </div>
                    </div>
                </div>

                <!-- 链表 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#linkedlist">
                            2. 链表 (Linked List)
                        </button>
                    </h2>
                    <div id="linkedlist" class="accordion-collapse collapse" data-bs-parent="#dataStructuresAccordion">
                        <div class="accordion-body">
                            <p><strong>特点：</strong></p>
                            <ul>
                                <li>非连续内存存储</li>
                                <li>插入/删除时间复杂度 O(1)</li>
                                <li>访问时间复杂度 O(n)</li>
                            </ul>
                            <p><strong>常见技巧：</strong></p>
                            <ul>
                                <li>快慢指针（检测环、找中点）</li>
                                <li>虚拟头节点</li>
                                <li>反转链表</li>
                            </ul>
                            <p><strong>典型题目：</strong>反转链表、检测环、合并两个有序链表</p>
                        </div>
                    </div>
                </div>

                <!-- 栈和队列 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#stackqueue">
                            3. 栈和队列 (Stack & Queue)
                        </button>
                    </h2>
                    <div id="stackqueue" class="accordion-collapse collapse" data-bs-parent="#dataStructuresAccordion">
                        <div class="accordion-body">
                            <p><strong>栈 (LIFO)：</strong></p>
                            <ul>
                                <li>括号匹配</li>
                                <li>单调栈</li>
                                <li>表达式求值</li>
                            </ul>
                            <p><strong>队列 (FIFO)：</strong></p>
                            <ul>
                                <li>BFS 遍历</li>
                                <li>滑动窗口最大值（单调队列）</li>
                                <li>层次遍历</li>
                            </ul>
                            <p><strong>典型题目：</strong>有效的括号、最小栈、滑动窗口最大值</p>
                        </div>
                    </div>
                </div>

                <!-- 哈希表 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#hashtable">
                            4. 哈希表 (Hash Table)
                        </button>
                    </h2>
                    <div id="hashtable" class="accordion-collapse collapse" data-bs-parent="#dataStructuresAccordion">
                        <div class="accordion-body">
                            <p><strong>特点：</strong></p>
                            <ul>
                                <li>平均 O(1) 的查找、插入、删除</li>
                                <li>空间换时间</li>
                                <li>无序存储</li>
                            </ul>
                            <p><strong>应用场景：</strong></p>
                            <ul>
                                <li>快速查找</li>
                                <li>计数统计</li>
                                <li>去重</li>
                            </ul>
                            <p><strong>典型题目：</strong>两数之和、字母异位词分组、最长连续序列</p>
                        </div>
                    </div>
                </div>

                <!-- 树 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#tree">
                            5. 树 (Tree)
                        </button>
                    </h2>
                    <div id="tree" class="accordion-collapse collapse" data-bs-parent="#dataStructuresAccordion">
                        <div class="accordion-body">
                            <p><strong>二叉树遍历：</strong></p>
                            <ul>
                                <li>前序遍历（根-左-右）</li>
                                <li>中序遍历（左-根-右）</li>
                                <li>后序遍历（左-右-根）</li>
                                <li>层序遍历（BFS）</li>
                            </ul>
                            <p><strong>特殊树：</strong></p>
                            <ul>
                                <li>二叉搜索树（BST）</li>
                                <li>平衡二叉树（AVL）</li>
                                <li>红黑树</li>
                                <li>B树/B+树</li>
                            </ul>
                            <p><strong>典型题目：</strong>二叉树的最大深度、路径总和、验证二叉搜索树</p>
                        </div>
