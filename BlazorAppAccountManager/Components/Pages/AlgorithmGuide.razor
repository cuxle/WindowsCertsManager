    <!-- 面试技巧 -->
    <div class="card mb-4">
        <div class="card-header bg-warning text-dark">
            <h2 class="h4 mb-0">四、面试技巧与准备建议</h2>
        </div>
        <div class="card-body">
            <h5>1. 面试前准备</h5>
            <ul>
                <li>熟练掌握至少一门编程语言（C++/Java/Python）</li>
                <li>刷题平台：LeetCode、牛客网、力扣</li>
                <li>推荐刷题量：200-300题（easy 30%, medium 60%, hard 10%）</li>
                <li>总结常见题型和解题模板</li>
            </ul>

            <h5>2. 面试中的沟通技巧</h5>
            <ul>
                <li><strong>理解题意：</strong>仔细阅读题目，询问边界条件和特殊情况</li>
                <li><strong>思路说明：</strong>先说思路，再写代码，让面试官理解你的想法</li>
                <li><strong>复杂度分析：</strong>主动分析时间和空间复杂度</li>
                <li><strong>测试用例：</strong>写完代码后，用测试用例验证</li>
                <li><strong>优化讨论：</strong>如果有更优解，主动提出讨论</li>
            </ul>

            <h5>3. 常见思路模板</h5>
            <div class="row">
                <div class="col-md-6">
                    <p><strong>双指针：</strong></p>
                    <pre><code>left = 0, right = n-1
while left &lt; right:
    if condition:
        left++
    else:
        right--</code></pre>
                </div>
                <div class="col-md-6">
                    <p><strong>滑动窗口：</strong></p>
                    <pre><code>left = 0
for right in range(n):
    add arr[right]
    while need_shrink:
        remove arr[left]
        left++</code></pre>
                </div>
            </div>

            <h5>4. 高频考点</h5>
            <div class="alert alert-primary" role="alert">
                <ul class="mb-0">
                    <li>数组：双指针、滑动窗口、前缀和</li>
                    <li>链表：快慢指针、反转、合并</li>
                    <li>树：遍历、递归、BFS/DFS</li>
                    <li>动态规划：背包、序列、路径问题</li>
                    <li>回溯：排列组合、棋盘问题</li>
                </ul>
            </div>

            <h5>5. 学习资源推荐</h5>
            <ul>
                <li><strong>书籍：</strong>《算法导论》、《剑指Offer》、《程序员代码面试指南》</li>
                <li><strong>在线课程：</strong>Coursera、MIT OpenCourseWare</li>
                <li><strong>刷题网站：</strong>LeetCode、力扣、牛客网</li>
                <li><strong>视频教程：</strong>B站、YouTube算法讲解</li>
            </ul>
        </div>
    </div>

    <!-- C#代码示例 -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <h2 class="h4 mb-0">五、C# 代码示例</h2>
        </div>
        <div class="card-body">
            <h5>1. 二分查找</h5>
            <pre><code class="language-csharp">public int BinarySearch(int[] nums, int target)
{
    int left = 0, right = nums.Length - 1;
    
    while (left &lt;= right)
    {
        int mid = left + (right - left) / 2;
        
        if (nums[mid] == target)
            return mid;
        else if (nums[mid] &lt; target)
            left = mid + 1;
        else
            right = mid - 1;
    }
    
    return -1;
}</code></pre>

            <h5>2. 快速排序</h5>
            <pre><code class="language-csharp">public void QuickSort(int[] nums, int left, int right)
{
    if (left >= right) return;
    
    int pivot = Partition(nums, left, right);
    QuickSort(nums, left, pivot - 1);
    QuickSort(nums, pivot + 1, right);
}

private int Partition(int[] nums, int left, int right)
{
    int pivot = nums[right];
    int i = left;
    
    for (int j = left; j &lt; right; j++)
    {
        if (nums[j] &lt; pivot)
        {
            (nums[i], nums[j]) = (nums[j], nums[i]);
            i++;
        }
    }
    
    (nums[i], nums[right]) = (nums[right], nums[i]);
    return i;
}</code></pre>

            <h5>3. 链表反转</h5>
            <pre><code class="language-csharp">public ListNode ReverseList(ListNode head)
{
    ListNode prev = null;
    ListNode curr = head;
    
    while (curr != null)
    {
        ListNode next = curr.next;
        curr.next = prev;
        prev = curr;
        curr = next;
    }
    
    return prev;
}</code></pre>

            <h5>4. 动态规划 - 爬楼梯</h5>
            <pre><code class="language-csharp">public int ClimbStairs(int n)
{
    if (n &lt;= 2) return n;
    
    int[] dp = new int[n + 1];
    dp[1] = 1;
    dp[2] = 2;
    
    for (int i = 3; i &lt;= n; i++)
    {
        dp[i] = dp[i - 1] + dp[i - 2];
    }
    
    return dp[n];
}</code></pre>
        </div>
    </div>

