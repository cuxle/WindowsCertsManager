@page "/Account/Login2"
@inject ILogger<Login2> Logger
<main class="d-flex w-100">
    <div class="container d-flex flex-column">
        <div class="row vh-100">
            <div class="col-sm-10 col-md-8 col-lg-6 col-xl-5 mx-auto d-table h-100">
                <div class="d-table-cell align-middle">
                    <div class="text-center mt-4">
                        <h1 class="h2">Welcome back!</h1>
                        <p class="lead">
                            Sign in to your account to continue
                        </p>
                    </div>

                    <div class="card">
                        <div class="card-body">
                            <div class="m-sm-3">
                                <EditForm Model="@loginModel" OnValidSubmit="HandleValidSubmit" FormName="loginForm">
                                    <DataAnnotationsValidator />
                                    <div class="mb-3">
                                        <label class="form-label">Email</label>
                                        <InputText class="form-control form-control-lg" @bind-Value="loginModel.Email" placeholder="Enter your email" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Password</label>
                                        <InputText class="form-control form-control-lg" type="password" @bind-Value="loginModel.Password" placeholder="Enter your password" />
                                    </div>
                                    <div>
                                        <div class="form-check align-items-center">
                                            <InputCheckbox id="customControlInline" class="form-check-input" @bind-Value="loginModel.RememberMe" />
                                            <label class="form-check-label text-small" for="customControlInline">Remember me</label>
                                        </div>
                                    </div>
                                    <div class="d-grid gap-2 mt-3">
                                        <button type="submit" class="btn btn-lg btn-primary">Sign in</button>
                                    </div>
                                </EditForm>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mb-3">
                        Don't have an account? <NavLink href="pages-sign-up.html">Sign up</NavLink>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@code {
    private LoginModel loginModel = new();

    private void HandleValidSubmit()
    {
        // Your login logic here.
        // You would typically use UserManager or SignInManager to authenticate the user.
        Logger.LogInformation($"Attempting to log in with email: {loginModel.Email}");
    }

    private class LoginModel
    {
        public string Email { get; set; }
        public string Password { get; set; }
        public bool RememberMe { get; set; }
    }
}